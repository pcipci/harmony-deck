  "options": {
    "step": {
      "init": {
        "title": "Настройки Harmony Deck",
        "description": "Технические настройки для каждого подключённого сетевого телевизора (LG Netcast). Карточке они не нужны. Выберите телевизор.",
        "data": {
          "device": "Телевизор"
        }
      },
      "device": {
        "title": "{name}",
        "description": "Технические настройки этого телевизора. Карточке они не нужны.",
        "sections": {
          "volume": {
            "name": "Громкость (телевизор знает только шаги громкости)",
            "description": "Регулятор громкости достигает цели отдельными шагами «громче» / «тише». Затем уровень читается, пока не перестанет меняться, и недостающие шаги отправляются снова.",
            "data": {
              "step_gap_ms": "Пауза между шагами",
              "corrections": "Коррекции",
              "settle_s": "Максимальное ожидание перед проверкой"
            },
            "data_description": {
              "step_gap_ms": "Короче быстрее, но слишком быстрые шаги телевизор теряет или проскакивает (по умолчанию 100 мс).",
              "corrections": "Сколько раз после проверки отправлять недостающие шаги (0 = никогда, по умолчанию 3).",
              "settle_s": "После последнего шага уровень читается примерно каждые полсекунды, пока не перестанет меняться, но не дольше этого (по умолчанию 2,5 с)."
            }
          },
          "picture": {
            "name": "Картинка ТВ (для автоматизаций, например цветных ламп)",
            "description": "Добавляет устройству этого телевизора сущности «Картинка ТВ», «Основной цвет» и «Картинка доступна». Картинка берётся из самого медиаплеера, ничего не покидает вашу сеть.",
            "data": {
              "picture": "Картинка ТВ",
              "picture_mode": "Новая картинка",
              "picture_interval_s": "Интервал опроса",
              "picture_timeout_s": "Время без картинки"
            },
            "data_description": {
              "picture": "По умолчанию выключено. Каждая картинка немного нагружает телевизор.",
              "picture_mode": "Когда медиаплеер сообщает о новой картинке или каждые несколько секунд.",
              "picture_interval_s": "Только при «каждые несколько секунд» (по умолчанию 2 с). Чаще, чем телевизор делает картинки, смысла нет.",
              "picture_timeout_s": "Если картинки нет так долго, «Картинка доступна» выключается, а основной цвет становится неизвестным; до этого цвет сохраняет последнее значение (по умолчанию 10 с)."
            }
          }
        }
      }
    },
    "abort": {
      "no_devices": "Нет подключённого сетевого телевизора с настройками. Сначала подключите телевизор LG Netcast в настройках карточки (вкладка «Сетевое управление»)."
    }
  },
