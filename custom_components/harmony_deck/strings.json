  "issues": {
    "harmony_missing": {
      "title": "No Harmony integration found",
      "description": "Harmony Deck needs the Home Assistant “Logitech Harmony Hub” integration. Set it up and the hubs will show up in the card."
    },
    "hub_unreadable": {
      "title": "Harmony hub “{hub}” is not readable",
      "description": "Harmony Deck cannot read the configuration of the hub “{hub}” from the Harmony integration. The card then only shows basic functions. Reload the Harmony integration or restart Home Assistant. Details: Harmony Deck › Download diagnostics."
    },
    "fire_unreachable": {
      "title": "Fire TV “{name}” is not reachable",
      "description": "Harmony Deck cannot reach “{name}” for several minutes. Its keys and apps then only work through Harmony, and its status in the card is unknown. Check that the device is on and ADB debugging is enabled (a sleeping Fire TV is often unreachable)."
    }
  },
  "services": {
    "run_action": {
      "name": "Run action",
      "description": "Starts an action (or sequence) of Harmony Deck. Refused while another action runs on the same hub.",
      "fields": {
        "hub": {
          "name": "Hub",
          "description": "Remote entity of the Harmony hub."
        },
        "action": {
          "name": "Action",
          "description": "Name or id of the action, as set in the card."
        }
      }
    },
    "stop_action": {
      "name": "Stop action",
      "description": "Stops the running action of a hub between two steps.",
      "fields": {
        "hub": {
          "name": "Hub",
          "description": "Remote entity of the Harmony hub."
        }
      }
    }
  },
  "device": {
    "network_device": {
      "name": "{name} (Network)"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Harmony Deck options",
        "description": "Technical settings. The card does not need them.",
        "sections": {
          "lg_netcast": {
            "name": "LG Netcast (TVs that only know volume steps)",
            "description": "The volume slider reaches the target with single louder / quieter steps. After the last step the real level is read again and missing steps are sent.",
            "data": {
              "step_gap_ms": "Gap between two steps",
              "corrections": "Corrections",
              "settle_s": "Wait before checking"
            },
            "data_description": {
              "step_gap_ms": "Shorter is faster, but a TV may drop steps that come too fast (default 150 ms).",
              "corrections": "How often missing steps are sent again after the check (0 = never, default 3).",
              "settle_s": "How long to wait after the last step before the TV's level is read again (default 2.5 s)."
            }
          }
        }
      }
    }
  }
}
