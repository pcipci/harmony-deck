        "hub": {
          "name": "Хаб",
          "description": "Объект remote хаба Harmony."
        },
        "action": {
          "name": "Команда",
          "description": "Имя или id команды, как задано в карточке."
        }
      }
    },
    "stop_action": {
      "name": "Прервать команду",
      "description": "Прерывает выполняемую команду хаба между двумя шагами.",
      "fields": {
        "hub": {
          "name": "Хаб",
          "description": "Объект remote хаба Harmony."
        }
      }
    }
  },
